@page "/addserver"
<h3>Add Server</h3>
<br />

<h3>AddServer</h3>

@inject NavigationManager NavigationManager

<EditForm Model="server" FormName="formAddServer" OnValidSubmit="Submit">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="row mb-3">
        <div class="col-2">
            <label class="col-form-label">Name</label>
        </div>
        <div class="col-6">
            <InputText @bind-Value="server.Name" class="form-control"></InputText>
        </div>
        <div class="col">
            <ValidationMessage For="@(() => server.Name)" />
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-2">
            <label class="col-form-label">City</label>
        </div>
        <div class="col-6">
            <InputText class="form-control" @bind-Value="server.City"></InputText>
        </div>
        <div class="col">
            <ValidationMessage For="@(() => server.City)" />
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-2">
            <label class="col-form-label">Is Online</label>
        </div>
        <div class="col-6">
            <InputCheckbox @bind-Value="server.IsOnline" class="form-check-input"></InputCheckbox>
        </div>
    </div>
<button type="submit" class="btn btn-primary">Save</button>

</EditForm>

@code {

    private Server? server { get; set; } = new Server();

    private void Submit()
    {
        if (server != null)
        {
            // Here you would typically save the server to a database or perform some action
            // Console.WriteLine($"Server Name: {server.Name}, City: {server.City}, Is Online: {server.IsOnline}");
            ServersRepository.AddServer(server);
            NavigationManager.NavigateTo("/servers"); 
        }
    }
}


