@page "/servers/{serverID:int}"
<h3>Edit Server</h3>
<br />

@inject NavigationManager NavigationManager
@if (server != null)
{
    
    /*
    <EditForm Model="@server" >
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="mb-3">
            <label for="name" class="form-label">Server Name</label>
            <InputText id="name" class="form-control" @bind-Value="server.Name" />
        </div>
        <div class="mb-3">
            <label for="city" class="form-label">City</label>
            <InputText id="city" class="form-control" @bind-Value="server.City" />
        </div>
        <div class="mb-3 form-check">
            <InputCheckbox id="isOnline" class="form-check-input" @bind-Value="server.IsOnline" />
            <label for="isOnline" class="form-check-label">Is Online</label>
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
    </EditForm>
    */

    // each form must have a unique name; this is why we are using FormName="formServer" here
    <EditForm Model="server" FormName="formServer" OnValidSubmit="Submit">
        <DataAnnotationsValidator />
        <ValidationSummary />

@*         The reason we need to add this hidden field is this: we are binding the "server" object to the form
        submission process, and this "server" object has multiple fields which each must have a value.  Presumably,
        those values are all zero or null by default, until they get set during the form submit process.  But if we
        do not set a given variable, it will remain as "zero".  That's what will happen with the "server.ServerID" since
        we do not put that variable on the screen.  That means that we don't know where this data came from, i.e. which 
        ServerID.  Therefore, by putting in a *hidden* value, it will get filled in automatically along with the other
        variables in the "server" object.
 *@        
        <InputNumber @bind-Value="server.ServerID" hidden></InputNumber>
        <div class="row mb-3">
            <div class="col-2">
                <label class="col-form-label">Name</label>
            </div>
            <div class="col-6">
                <InputText @bind-Value="server.Name" class="form-control"></InputText>
            </div>
            <div class="col">
                <ValidationMessage For="@(() => server.Name)" />    
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-2">
                <label class="col-form-label">City</label>
            </div>
            <div class="col-6">
                <InputText class="form-control" @bind-Value="server.City"></InputText>
            </div>
            <div class="col">
        @*  Note that the instructor did not use the @ sign but Copilot says it is required.
         *@
         <ValidationMessage For="@(() => server.City)" />  // note that thi
            </div>

        </div>

        <div class="row mb-3">
            <div class="col-2">
                <label class="col-form-label">Online?</label>
            </div>
            <div class="col-6">
                <InputCheckbox class="form-check-input" @bind-Value="server.IsOnline"></InputCheckbox>
            </div>


        </div>
        <button class="btn btn-outline-secondary" type="submit">Update</button>
        &nbsp;
        <a href="/servers" class="btn btn-light">Back to Servers</a>

    </EditForm>

}
else
{
    <p>Server not found.</p>
}


@code {
    [Parameter]
    public int serverID { get; set; }

    [SupplyParameterFromForm(FormName = "formServer")] // this will enable Blazor framework to bind the form data to this property when the form is submitted
    private Server? server { get; set; } // this had to be changed to a property

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

// DJS: there is a bug here; if the location is updated, then when you
        // return to Servers page, that server will be missing.  This is because the server object is being updated in memory, but not in the repository.  
        // // Therefore, when you return to the Servers page, it will not find that server in the repository.  
        // To fix this, we need to update the server in the repository when the form is submitted.  This is done in the Submit method below.
        // Note that this *does work correctly now* - what was appearing to be wrong was that I had updated the location of a server,
// but in the code I was hardcoding to only pull servers from Toronto, so when I redisplayed the list of servers,
// since I had changed one of my servers from Toronto to Montreal (for example), naturally , the updated server would not
// show up in the list of servers in Toronto.  Duh.

        server ??= ServersRepository.GetServerById(serverID);

    }

    // DJS: herein is the crux of why Blazor is so special; 
    // It allows us to submit using C# code instead of having to use JavaScript.  
    // 
    private void Submit(EditContext editContext)
    {
        /*
        if (editContext.Validate())
        {
            ServersRepository.UpdateServer(server);
            NavigationManager.NavigateTo("/servers");
            }
        */

        if (server != null)
        {
            ServersRepository.UpdateServer(server.ServerID, server);
            NavigationManager.NavigateTo("/servers");
        }
    }

}
