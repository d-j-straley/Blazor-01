@page "/servers/{serverID:int}"
<h3>Edit Server</h3>
<br />
<br />
The ID is @serverID 
<br />


@code {
    [Parameter]
    public int serverID { get; set; }
    private Server? server;
    protected override void OnInitialized()
    {
        server = ServersRepository.GetServerById(serverID);
    }

}
