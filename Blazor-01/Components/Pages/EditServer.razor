@page "/servers/{serverID}"
<h3>Edit Server</h3>
<br />
<br />
The ID is @serverID 
<br />


@code {
    [Parameter]
    public string? serverID { get; set; }
    private Server? server;
    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(serverID) && int.TryParse(serverID, out int id))
        {
            if (id < 1)
            {
                throw new ArgumentException("Server ID must be greater than 0.");
            }

            server = ServersRepository.GetServerById(id);
        }
    }

}
